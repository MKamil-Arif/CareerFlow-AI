# Copy to ".env" in the repository root for local development.
# On Render / Hugging Face, set these in the dashboard instead (never commit real keys).

# At least one key enables AI features. Without keys, every feature uses offline fallbacks.
GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.7-flash

# development | production  (production turns off the localhost:5500 CORS defaults and enables HSTS)
APP_ENV=development
LOG_LEVEL=INFO

# Only needed if the frontend is hosted on a different domain than the API (comma separated).
CORS_ORIGINS=

# Abuse protection for a public deployment (requests per minute per visitor IP; 0 = off).
RATE_LIMIT_AI_PER_MINUTE=20
RATE_LIMIT_DEFAULT_PER_MINUTE=120
MAX_UPLOAD_MB=5
AI_TIMEOUT_SECONDS=25
